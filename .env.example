# Base URL of the AI FLOW backend (see ../ai-flow-backend). No trailing slash.
VITE_API_BASE_URL=http://localhost:8000

# Where the built widget.js bundle is statically hosted for customers to embed
# (usually the same static host as this dashboard app, e.g. Vercel). Defaults
# to a same-origin relative path if unset.
VITE_WIDGET_SCRIPT_URL=http://localhost:5173/widget.js
